package com.example.SB_Day1Practice;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.ResponseBody;

import java.util.Random;

@Controller
public class ButtonController {
    @GetMapping("/")
    @ResponseBody
    public String intro(){ //August 15 Test:Basic, needs more practice with the return methodology
        return "<h2>Return a random integer</h2>"+
                "<div style='display: flex; gap: 100px; align-items: center;'>" + //Spacing layout
                "  <form action='/Value1' method='POST'>" + //Note:Stage ACTION-INPUT
                "    <button type='submit'>Option 1</button>" + //Frontend
                "  </form>" + //Space
                "  <form action='/Value2' method='POST'>" +
                "    <button type='submit'>Option 2</button>" +
                "  </form>" +
                "</div>";
    }
    //Practice for PostMapping:Post actually means INPUT here,so in a way initializing the value;
    @PostMapping("/Value1")
    @ResponseBody
    public String return_Op1(){ //August 15 Test:Proficient
        //Catch:How to use Random() in a Spring Boot setting with 1 or 2 parameters:KNOW Them!
        return Integer.toString(new Random().nextInt(1,5));
    }

    @PostMapping("/Value2")
    @ResponseBody
    public String return_Op2(){ //August 15 Test:Proficient
        return Integer.toString(new Random().nextInt(6,10));
    }
}
